<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EZ-PD capture report</title>
<style>
:root{
  --page:#f9f9f7; --surface:#fcfcfb; --ink:#0b0b0b; --ink-2:#52514e;
  --muted:#898781; --grid:#e1e0d9; --axis:#c3c2b7;
  --border:rgba(11,11,11,.10); --series-1:#2a78d6;
}
@media (prefers-color-scheme: dark){
  :root{
    --page:#0d0d0d; --surface:#1a1a19; --ink:#ffffff; --ink-2:#c3c2b7;
    --muted:#898781; --grid:#2c2c2a; --axis:#383835;
    --border:rgba(255,255,255,.10); --series-1:#3987e5;
  }
}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);
  font:14px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif;padding:24px}
h1{font-size:20px;margin:0 0 2px}
.sub{color:var(--muted);font-size:12px;margin:0 0 20px}
section.capture{background:var(--surface);border:1px solid var(--border);
  border-radius:10px;padding:18px 20px;margin:0 0 22px}
h2{font-size:15px;margin:0;word-break:break-all}
.meta{color:var(--ink-2);font-size:12px;margin:2px 0 10px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px}
.chip{border:1px solid var(--border);border-radius:999px;padding:1px 9px;
  font-size:12px;color:var(--ink-2)}
.chip b{color:var(--ink);font-weight:600}
.chart-wrap{position:relative;margin:0 0 6px}
.chart-title{font-size:12px;color:var(--ink-2);margin:0 0 4px;font-weight:600}
svg.chart{display:block;width:100%;height:auto;outline:none}
svg.chart:focus-visible{outline:2px solid var(--series-1);outline-offset:2px;border-radius:4px}
.tick text{fill:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
.panel-title{fill:var(--ink-2);font-size:11px;font-weight:600}
.tip{position:absolute;pointer-events:none;background:var(--surface);
  border:1px solid var(--border);border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.12);
  padding:6px 9px;font-size:12px;display:none;white-space:nowrap;z-index:2}
.tip .v{font-weight:600;font-size:13px}
.tip .v::before{content:"";display:inline-block;width:12px;height:0;
  border-top:2px solid var(--series-1);vertical-align:middle;margin-right:6px}
.tip .d{color:var(--ink-2)}
.controls{display:flex;align-items:center;gap:16px;margin:12px 0 8px;flex-wrap:wrap}
.controls input[type=search]{background:var(--page);color:var(--ink);
  border:1px solid var(--border);border-radius:6px;padding:4px 9px;font:inherit;
  font-size:13px;width:220px}
.controls label{color:var(--ink-2);font-size:13px;display:flex;gap:6px;align-items:center}
.controls .shown{color:var(--muted);font-size:12px;margin-left:auto}
.tbl-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:8px}
table{border-collapse:collapse;width:100%;font-size:12.5px}
th{position:sticky;top:0;background:var(--surface);color:var(--ink-2);
  text-align:left;font-weight:600;padding:6px 10px;border-bottom:1px solid var(--axis);
  white-space:nowrap}
td{padding:4px 10px;border-bottom:1px solid var(--grid);white-space:nowrap;
  font-variant-numeric:tabular-nums}
tr:last-child td{border-bottom:none}
td.num{text-align:right}
th.num{text-align:right}
td.data{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px}
tr.goodcrc td{color:var(--muted)}
.empty{color:var(--muted);padding:10px;font-size:13px}
tr.expandable{cursor:pointer}
tr.expandable:hover td{background:color-mix(in srgb, var(--series-1) 6%, transparent)}
td .caret{display:inline-block;width:1em;color:var(--muted);
  transition:transform .12s ease}
tr.open td .caret{transform:rotate(90deg)}
tr.decode-row>td{padding:2px 10px 10px 34px;white-space:normal;
  background:color-mix(in srgb, var(--series-1) 4%, transparent)}
ul.dec{list-style:none;margin:4px 0 0;padding:0 0 0 0;font-size:12px}
ul.dec ul.dec{padding-left:18px;border-left:1px solid var(--grid);margin-left:4px}
ul.dec>li{margin:1px 0}
ul.dec .dn{color:var(--ink-2)}
ul.dec .dv{color:var(--ink);font-weight:500;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px}
ul.dec>li.top>.dn{font-weight:600;color:var(--ink)}
.summary{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;margin:0 0 14px;
  padding:10px 12px;border:1px solid var(--border);border-radius:8px;
  background:color-mix(in srgb, var(--series-1) 4%, transparent);font-size:12.5px}
.summary .sk{color:var(--ink-2);font-weight:600}
.summary .sv{color:var(--ink)}
td.event{white-space:nowrap}
tr.event-row td{background:color-mix(in srgb, var(--series-1) 7%, transparent)}
tr.event-row td.event{font-weight:600}
.decraw{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px;
  color:var(--ink-2);margin:4px 0 2px;word-break:break-all}
</style>
</head>
