  svg.addEventListener("pointerleave", hide);
  svg.addEventListener("keydown", ev => {
    if (ev.key === "ArrowRight") show(Math.min(pts.length - 1, cur + 1));
    else if (ev.key === "ArrowLeft") show(Math.max(0, cur < 0 ? 0 : cur - 1));
    else if (ev.key === "Escape") hide();
    else return;
    ev.preventDefault();
  });
  svg.addEventListener("focus", () => { if (cur < 0) show(0); });
  svg.addEventListener("blur", hide);
}

function renderTable(host, pkts, hasOk) {
  const t0 = Math.min(...pkts.map(p => num(p.sTime)).filter(v => v !== null));
  const cols = [
    ["sno", "sno", "num"], ...(hasOk ? [["ok", "status", ""]] : []),
    ["sop", "SOP", ""], ["msg", "message", ""], ["dRole", "dRole", ""],
    ["pRole", "pRole", ""], ["rev", "rev", ""], ["vbus", "VBUS (mV)", "num"],
    ["sTime", "t (s)", "num"], ["duration", "dur (µs)", "num"],
    ["delta", "delta (µs)", "num"], ["event", "event", "event"],
  ];
  const controls = el("div", {class: "controls"});
  const search = el("input", {type: "search", placeholder: "Filter message / data / role…"});
  const cb = el("input", {type: "checkbox"});
  const cbLabel = el("label"); cbLabel.append(cb, document.createTextNode("Show GOODCRC"));
  const evOnly = el("input", {type: "checkbox"});
  const evLabel = el("label"); evLabel.append(evOnly, document.createTextNode("Only events"));
  const shown = el("span", {class: "shown"});
  controls.append(search, cbLabel, evLabel, shown);

  const wrap = el("div", {class: "tbl-wrap"});
  const table = el("table");
  const thead = el("thead"), hr = el("tr");
  for (const [, label, cls] of cols) hr.append(el("th", cls ? {class: cls} : {}, label));
  thead.append(hr);
  const tbody = el("tbody");
  table.append(thead, tbody);
  wrap.append(table);
  host.append(controls, wrap);

  const decList = (details, top) => {
    const ul = el("ul", {class: "dec"});
    for (const d of details) {
      const li = el("li", top ? {class: "top"} : {});
      li.append(el("span", {class: "dn"}, d.n + ": "),
                el("span", {class: "dv"}, d.v));
      if (d.s && d.s.length) li.append(decList(d.s, false));
      ul.append(li);
    }
    return ul;
  };

  const draw = () => {
    const q = search.value.trim().toLowerCase();
    tbody.replaceChildren();
    let n = 0;
    for (const p of pkts) {
      const isCrc = p.msg === "GOODCRC";
      if (isCrc && !cb.checked) continue;
      if (evOnly.checked && !p.event) continue;
      if (q && ![p.msg, p.data, p.sop, p.dRole, p.pRole, p.ok, p.event]
          .some(v => (v || "").toLowerCase().includes(q))) continue;
      const cls = [isCrc ? "goodcrc" : "", p.event ? "event-row" : ""]
        .filter(Boolean).join(" ");
      const tr = el("tr", cls ? {class: cls} : {});
      let first = true;
      for (const [key, , cls] of cols) {
        let v = p[key] ?? "";
        if (key === "sTime") {
          const t = num(v);
          v = t === null ? "" : fmt((t - t0) / 1e6, 3);
        }
        const td = el("td", cls ? {class: cls} : {});
        if (first && p.dec) td.append(el("span", {class: "caret"}, "▸"));
        td.append(document.createTextNode(v));
        tr.append(td);
        first = false;
      }
      if (p.dec) {
        tr.classList.add("expandable");
        tr.addEventListener("click", () => {
          const open = tr.classList.toggle("open");
          if (open) {
            const dr = el("tr", {class: "decode-row"});
            const td = el("td", {colspan: cols.length});
            if (p.data) td.append(el("div", {class: "decraw"}, "Raw: " + p.data));
            td.append(decList(p.dec, true));
            dr.append(td);
            tr.after(dr);
          } else if (tr.nextSibling?.classList?.contains("decode-row")) {
            tr.nextSibling.remove();
          }
        });
      }
      tbody.append(tr); n++;
    }
    shown.textContent = `${n} of ${pkts.length} packets`;
    if (!n) {
      const tr = el("tr"), td = el("td", {class: "empty", colspan: cols.length},
        "No packets match the current filter.");
      tr.append(td); tbody.append(tr);
    }
  };
  search.addEventListener("input", draw);
  cb.addEventListener("change", draw);
  evOnly.addEventListener("change", draw);
  draw();
}

function renderScope(wrap, scope) {
  const t = scope.t;
  if (!t || t.length < 2) {
    wrap.append(el("p", {class: "empty"}, "No scope data to plot."));
    return;
  }
  const series = [
    {arr: scope.v, label: "VBUS", unit: "V", dp: 2},
    {arr: scope.i, label: "Current", unit: "A", dp: 2},
    {arr: scope.p, label: "Power", unit: "W", dp: 1},
  ];
  const W = 960, ml = 54, mr = 14, mt = 10, panelH = 92, gap = 24, mb = 26;
  const pw = W - ml - mr;
  const plotsH = series.length * panelH + (series.length - 1) * gap;
  const H = mt + plotsH + mb;
  const xMax = t[t.length - 1] || 1;
  const X = x => ml + (x / xMax) * pw;

  const svg = svgEl("svg", {class: "chart", viewBox: `0 0 ${W} ${H}`,
    tabindex: "0", role: "img",
    "aria-label": "VBUS, current and power over time; values are in the table above"});

  const panels = series.map((s, k) => {
    const yTop = mt + k * (panelH + gap);
    const yTicks = niceTicks(Math.max(...s.arr, 0));
    const yMax = yTicks[yTicks.length - 1] || 1;
    const Y = v => yTop + panelH - (v / yMax) * panelH;
    for (const gv of yTicks) {
      const g = svgEl("g", {class: "tick"});
      g.append(svgEl("line", {x1: ml, x2: W - mr, y1: Y(gv), y2: Y(gv),
        stroke: gv === 0 ? "var(--axis)" : "var(--grid)", "stroke-width": 1}));
      const tx = svgEl("text", {x: ml - 8, y: Y(gv) + 3.5, "text-anchor": "end"});
      tx.textContent = gv;
      g.append(tx);
      svg.append(g);
    }
    const title = svgEl("text", {x: ml, y: yTop - 3, class: "panel-title"});
    title.textContent = `${s.label} (${s.unit})`;
    svg.append(title);
    let line = `M${X(t[0]).toFixed(1)} ${Y(s.arr[0]).toFixed(1)}`;
    for (let i = 1; i < t.length; i++)
      line += `L${X(t[i]).toFixed(1)} ${Y(s.arr[i]).toFixed(1)}`;
    const area = line + `L${X(xMax).toFixed(1)} ${Y(0).toFixed(1)}` +
      `L${X(t[0]).toFixed(1)} ${Y(0).toFixed(1)}Z`;
    svg.append(svgEl("path", {d: area, fill: "var(--series-1)", opacity: ".1"}));
    svg.append(svgEl("path", {d: line, fill: "none", stroke: "var(--series-1)",
      "stroke-width": 1.5, "stroke-linejoin": "round"}));
    const dot = svgEl("circle", {r: 3.5, fill: "var(--series-1)",
      stroke: "var(--surface)", "stroke-width": 2, visibility: "hidden"});
    svg.append(dot);
    return {s, Y, dot};
  });

  for (const xv of niceTicks(xMax, 8)) {
    const tx = svgEl("text", {class: "tick", x: X(xv), y: H - mb + 16, "text-anchor": "middle"});
    tx.textContent = `${+xv.toFixed(3)} s`;
    svg.append(svgEl("g", {class: "tick"})).append(tx);
  }

  const cross = svgEl("line", {y1: mt, y2: mt + plotsH, stroke: "var(--axis)",
    "stroke-width": 1, visibility: "hidden"});
  svg.append(cross);

  const tip = el("div", {class: "tip"});
  wrap.append(svg, tip);

  const show = i => {
    const px = X(t[i]);
    cross.setAttribute("x1", px); cross.setAttribute("x2", px);
    cross.setAttribute("visibility", "visible");
    for (const p of panels) {
      p.dot.setAttribute("cx", px); p.dot.setAttribute("cy", p.Y(p.s.arr[i]));
      p.dot.setAttribute("visibility", "visible");
    }
    tip.replaceChildren(el("div", {class: "d"}, `t = ${fmt(t[i], 3)} s`));
    for (const p of panels)
      tip.append(el("div", {class: "v"},
        `${p.s.label}: ${fmt(p.s.arr[i], p.s.dp)} ${p.s.unit}`));
    tip.style.display = "block";
    const r = svg.getBoundingClientRect(), sx = r.width / W;
    const left = px * sx + 12, flip = left + tip.offsetWidth + 8 > r.width;
    tip.style.left = `${flip ? px * sx - tip.offsetWidth - 12 : left}px`;
    tip.style.top = "0px";
  };
  const hide = () => {
    cross.setAttribute("visibility", "hidden");
    for (const p of panels) p.dot.setAttribute("visibility", "hidden");
    tip.style.display = "none";
  };

  svg.addEventListener("pointermove", ev => {
    const r = svg.getBoundingClientRect();
    const x = ((ev.clientX - r.left) / r.width * W - ml) / pw * xMax;
    let best = 0;
    for (let i = 1; i < t.length; i++)
      if (Math.abs(t[i] - x) < Math.abs(t[best] - x)) best = i;
    show(best);
  });
  svg.addEventListener("pointerleave", hide);
}

const app = document.getElementById("app");
for (const ds of DATA) {
  const sec = el("section", {class: "capture"});
  sec.append(el("h2", {}, ds.label));

  const times = ds.pkts.map(p => num(p.sTime)).filter(v => v !== null);
  const span = times.length ? (Math.max(...times) - Math.min(...times)) / 1e6 : 0;
  sec.append(el("p", {class: "meta"},
    `${ds.pkts.length} packets · ${fmt(span, 2)} s span`));

  const counts = new Map();
  for (const p of ds.pkts) {
    const k = p.msg || "?";
    counts.set(k, (counts.get(k) || 0) + 1);
  }
  const chips = el("div", {class: "chips"});
  [...counts.entries()].sort((a, b) => b[1] - a[1]).forEach(([msg, n]) => {
    const c = el("span", {class: "chip"});
    c.append(el("b", {}, msg), document.createTextNode(` ×${n}`));
    chips.append(c);
  });
  sec.append(chips);

  if (ds.summary) {
    const panel = el("div", {class: "summary"});
    for (const [k, v] of [["Cable", ds.summary.cable],
                          ["Partner", ds.summary.partner],
                          ["Contract", ds.summary.contract]]) {
      panel.append(el("span", {class: "sk"}, k), el("span", {class: "sv"}, v || "—"));
    }
    sec.append(panel);
  }

  sec.append(el("p", {class: "chart-title"}, "VBUS (V) per packet"));
  const wrap = el("div", {class: "chart-wrap"});
  sec.append(wrap);
  renderChart(wrap, ds.pkts);

  if (ds.scope) {
    sec.append(el("p", {class: "chart-title"}, "Oscilloscope — VBUS / current / power"));
    const swrap = el("div", {class: "chart-wrap"});
    sec.append(swrap);
    renderScope(swrap, ds.scope);
  }

  const hasOk = ds.pkts.some(p => p.ok);
  renderTable(sec, ds.pkts, hasOk);
  app.append(sec);
}
</script>
